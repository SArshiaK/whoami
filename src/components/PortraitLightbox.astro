---
import { asset } from "../lib/asset";
---

  <div
    class="portrait-lightbox"
    id="portraitLightbox"
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
    aria-label="Amir Mohammad Kahfi"
    hidden
  >
    <button type="button" class="portrait-lightbox__backdrop" id="portraitCloseBg" tabindex="-1" aria-label="Close photo"></button>
    <div class="portrait-lightbox__stage">
      <img
        class="portrait-lightbox__img"
        id="portraitFull"
        src={asset("images/portrait.jpg")}
        alt="Amir Mohammad Kahfi"
        width="800"
        height="1000"
      />
      <p class="portrait-lightbox__caption">Amir Mohammad Kahfi</p>
      <button type="button" class="portrait-lightbox__close" id="portraitClose" aria-label="Close photo">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>
