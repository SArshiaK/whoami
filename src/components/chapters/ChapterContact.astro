---
import { asset } from "../../lib/asset";
---

        <!-- CHAPTER 06: SCALE & CONTACT -->
        <section class="chapter chapter--6" id="ch-6">
          <div class="chapter__wrap chapter-contact">
            <span class="eyebrow"><i></i> STAGE 06 // SCALE &amp; IMPACT</span>
            <h2 class="hero__stage-title" style="margin-bottom:1.5rem">
              TESTED IN PRODUCTION.<br /><em>GROUNDED IN SCIENCE.</em>
            </h2>

            <div class="hero__stats hero__stats--interactive hero__stats--3" style="margin-top:0.5rem; margin-bottom:1.8rem">
              <div class="stat">
                <b><span class="stat__num" data-count="3">3</span><em>+</em></b>
                <span>Years shipping software</span>
              </div>
              <div class="stat">
                <b><span class="stat__num" data-count="12">12</span>K<em>+</em></b>
                <span>Android app installs</span>
              </div>
              <div class="stat">
                <b>M.Sc<em>.</em></b>
                <span class="stat__meta">
                  <img
                    class="brand-logo brand-logo--meta"
                    src={`${asset("logos/iust.png")}?v=5`}
                    alt=""
                    width="28"
                    height="28"
                    loading="lazy"
                    decoding="async"
                  />
                  <span>IUST · 2025 — present</span>
                </span>
              </div>
            </div>

            <a class="chapter-contact__mail" href="mailto:arshia9314@gmail.com">
              arshia9314@gmail.com
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M7 17L17 7M17 7H8M17 7V16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </a>

            <div class="chapter-contact__links">
              <a href="https://github.com/SArshiaK" target="_blank" rel="noreferrer">GitHub ↗</a>
              <a href="https://linkedin.com/in/sarshiak" target="_blank" rel="noreferrer">LinkedIn ↗</a>
            </div>

            <footer class="foot" style="margin-top:2rem">
              <span>© 2026 Amir Mohammad Kahfi</span>
              <a href="#top" data-nav="0">Back to origin ↑</a>
            </footer>
          </div>
        </section>
