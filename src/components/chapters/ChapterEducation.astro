---
import { asset } from "../../lib/asset";
---

        <!-- CHAPTER 05: EDUCATION & RESEARCH -->
        <section class="chapter chapter--5" id="ch-5">
          <div class="chapter__wrap chapter-edu">
            <div class="sec__head">
              <div>
                <span class="sec__idx">05 — Education</span>
                <h2 class="sec__title">Still taking notes.</h2>
              </div>
              <p class="sec__note">Self-healing systems · federated learning</p>
            </div>

            <div class="edu__grid">
              <article class="edu__card">
                <span class="edu__time">2025 — Present</span>
                <h3 class="edu__degree">M.Sc., Computer Software Engineering</h3>
                <p class="edu__school">
                  <img
                    class="brand-logo"
                    src={`${asset("logos/iust.png")}?v=3`}
                    alt=""
                    width="44"
                    height="44"
                    loading="lazy"
                    decoding="async"
                  />
                  <span>Iran University of Science and Technology</span>
                </p>
                <div class="edu__meta">
                  <div><span>Seminar</span><b>Self-healing in federated learning</b></div>
                  <div><span>Thesis</span><b>To be determined</b></div>
                </div>
              </article>

              <article class="edu__card">
                <span class="edu__time">2020 — 2025</span>
                <h3 class="edu__degree">B.Sc., Computer Engineering</h3>
                <p class="edu__school">
                  <img
                    class="brand-logo"
                    src={`${asset("logos/shahed.png")}?v=3`}
                    alt=""
                    width="44"
                    height="44"
                    loading="lazy"
                    decoding="async"
                  />
                  <span>Shahed University</span>
                </p>
                <div class="edu__meta">
                  <div><span>Final project</span><b>University job-board platform</b></div>
                  <div><span>Presented to</span><b>Faculty panel</b></div>
                </div>
              </article>
            </div>

            <a
              class="edu__card edu__lab"
              href="https://webpages.iust.ac.ir/msharifi/dslab.html#members"
              target="_blank"
              rel="noreferrer"
              style="text-decoration:none;"
            >
              <div>
                <span class="edu__time">
                  <img
                    class="brand-logo brand-logo--sm"
                    src={`${asset("logos/iust.png")}?v=3`}
                    alt=""
                    width="32"
                    height="32"
                    loading="lazy"
                    decoding="async"
                  />
                  Lab · IUST
                </span>
                <h3 class="edu__degree">Distributed Systems Lab</h3>
                <p class="edu__school">
                  Part of the Distributed Systems Lab team — around federated learning and
                  self-healing distributed systems.
                </p>
              </div>
              <span class="edu__lab__go">View lab members ↗</span>
            </a>

            <div class="stack" style="margin-top:1.1rem">
              <div class="stack__row">
                <span class="stack__label">Languages</span>
                <div class="stack__chips">
                  <span class="chip">Persian — Native</span>
                  <span class="chip">English — Intermediate</span>
                </div>
              </div>
            </div>
          </div>
        </section>
