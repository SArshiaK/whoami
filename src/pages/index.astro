---
import Layout from "../layouts/Layout.astro";
import PortfolioNav from "../components/PortfolioNav.astro";
import PortraitLightbox from "../components/PortraitLightbox.astro";
import ResumeLightbox from "../components/ResumeLightbox.astro";
import JourneyHud from "../components/JourneyHud.astro";
import ChapterHero from "../components/chapters/ChapterHero.astro";
import ChapterAbout from "../components/chapters/ChapterAbout.astro";
import ChapterStack from "../components/chapters/ChapterStack.astro";
import ChapterExperience from "../components/chapters/ChapterExperience.astro";
import ChapterWork from "../components/chapters/ChapterWork.astro";
import ChapterEducation from "../components/chapters/ChapterEducation.astro";
import ChapterContact from "../components/chapters/ChapterContact.astro";
import { stack, jobs, projects } from "../data/portfolio";
---

<Layout
  title="Amir Mohammad Kahfi — Software Engineer"
  description="Back-end-focused software engineer building Node.js systems and the retrieval layers that make LLMs useful. Nest.js, PostgreSQL, Redis, Docker, RAG and vector search."
>
  <div class="progress" id="progress"></div>

  <div class="cursor-hud" aria-hidden="true">
    <div class="cursor-hud__ring"></div>
    <div class="cursor-hud__dot"></div>
    <div class="cursor-hud__coords">0000 · 0000</div>
  </div>

  <PortfolioNav />
  <PortraitLightbox />
  <ResumeLightbox />

  <main id="top">
    <div class="journey-track" id="journeyTrack">
      <div class="journey-viewport" id="journeyViewport">
        <!-- Full-screen WebGL 3D Canvas -->
        <canvas id="threeCanvas" class="journey__canvas" aria-hidden="true"></canvas>

        <JourneyHud />

        <ChapterHero />
        <ChapterAbout />
        <ChapterStack stack={stack} />
        <ChapterExperience jobs={jobs} />
        <ChapterWork projects={projects} />
        <ChapterEducation />
        <ChapterContact />
      </div>
    </div>
  </main>

  <script>
    import "../scripts/main";
  </script>
</Layout>
