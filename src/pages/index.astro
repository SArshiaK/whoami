---
import Layout from "../layouts/Layout.astro";

const asset = (path: string) =>
  `${import.meta.env.BASE_URL}${path.replace(/^\//, "")}`;

const stack = [
  { k: "Frameworks", v: ["Nest.js", "Express.js", "Next.js", "React.js"] },
  { k: "ORM / ODM", v: ["Sequelize", "TypeORM", "Mongoose", "Prisma"] },
  { k: "Databases", v: ["PostgreSQL", "MongoDB", "MySQL", "Redis"] },
  { k: "APIs", v: ["REST", "gRPC", "Swagger", "SMS.ir", "PayPing", "IdPay", "Zibal"] },
  { k: "Real-time", v: ["Socket.IO", "gRPC services"] },
  { k: "AI & LLM", v: ["OpenAI-compatible APIs", "Ollama", "Embeddings", "RAG", "Qdrant", "ChromaDB", "Prompt engineering", "JSON mode"] },
  { k: "DevOps", v: ["Docker", "Kubernetes (basic)", "GitHub Actions", "GitLab CI"] },
  { k: "Developer Tools", v: ["Postman", "Cursor", "Claude Code"] },
];

const jobs = [
  {
    time: "Dec 2025 — Aug 2026",
    type: "Part-time",
    role: "Software Engineer",
    org: "Faraz Co · Iran Zamin Bank Technology Development",
    logo: { src: asset("logos/faraz.png"), alt: "Faraz" },
    desc: "Back-end engineering with a focus on LLM features in production — retrieval pipelines, embedding services and support tooling built for real users.",
  },
  {
    time: "Jun 2023 — Present",
    type: "Full-time",
    role: "Back-end Developer",
    org: "DPA · Dade Pardazi Azmoodeh Karan",
    desc: "Server-side services, data pipelines and internal tools for legal, audit and financial workflows — from web crawlers and RAG assistants to automated financial data pipelines.",
  },
  {
    time: "Apr — Jun 2023",
    type: "Full-time",
    role: "Back-end Developer Intern",
    org: "IZICenter · Iran Zamin Bank Innovation Center",
    logo: { src: asset("logos/iranzamin.png"), alt: "Iran Zamin Bank" },
    desc: "Started at the bank's innovation center: back-end features, internal panels, and the first release of a published Android app.",
  },
];

const projects = [
  {
    n: "01",
    tag: "RAG / LLM",
    title: "Troubleshooting Support Chatbot",
    org: "Faraz Co · pre-production testing",
    logo: { src: asset("logos/faraz.png"), alt: "Faraz" },
    when: "2026",
    featured: true,
    summary:
      "A chatbot that tells users how to fix problems, grounded in about 1,000 existing troubleshooting records.",
    points: [
      "Built the embedding pipeline with Sentence Transformers and stored vectors in ChromaDB.",
      "Every message triggers a vector search; the matches go into a prompt the LLM answers from, with local and API models plus chat history.",
      "Added BM25 keyword search in parallel with semantic search to raise retrieval accuracy.",
      "Implemented micro-batching to group near-simultaneous embedding requests within tight time windows, maintaining high throughput under concurrent traffic.",
    ],
    stack: ["Sentence Transformers", "ChromaDB", "BM25", "Local & API LLMs", "Micro-batching"],
  },
  {
    n: "02",
    tag: "RAG / LEGAL",
    title: "Legal-Domain RAG Assistant",
    org: "DPA · full data pipeline from scratch",
    when: "2025",
    summary:
      "A chatbot that explains legal and regulatory questions — crawling, chunking and retrieval all built in-house.",
    points: [
      "Crawled legal websites, used an LLM to chunk the text, and had it generate categories and summaries for each chunk, stored in Qdrant.",
      "Retrieval routes the question to a category first, then runs vector search and parallel BM25 keyword search.",
      "Answers cite exact legal articles, and the interface shows which parts are verbatim law and which are model analysis.",
      "Reduced hallucination with prompt constraints (analyze, never invent law) and a lower temperature.",
    ],
    stack: ["Qdrant", "Web crawling", "LLM chunking", "BM25", "Prompt engineering"],
  },
  {
    n: "03",
    tag: "AUTOMATION",
    title: "Audit & Fund Compliance Automation",
    org: "DPA · ongoing",
    when: "2024 — NOW",
    summary:
      "Internal tools that replaced manual accounting and audit work with queued, verifiable pipelines.",
    points: [
      "Bond yield: automated bulk data ingestion via background queues with instant yield calculations, replacing manual record-by-record entry.",
      "Fund threshold checks: regulatory limits are verified automatically from the uploaded fund assets.",
      "Audit automation: uploading a company's detailed accounting documents runs all calculations and checklists automatically.",
    ],
    stack: ["Node.js", "Background job queues", "Batch Data Processing"],
  },
  {
    n: "04",
    tag: "INTERNAL TOOLS",
    title: "Admin Panels & Reporting",
    org: "IZICenter · Faraz Co",
    logo: { src: asset("logos/iranzamin.png"), alt: "Iran Zamin Bank" },
    when: "2023 — NOW",
    summary:
      "Internal admin panels with data display and reporting features, used by operations teams behind the scenes.",
    points: [],
    stack: ["Admin panels", "Reporting", "Internal tools"],
  },
  {
    n: "05",
    tag: "SHIPPED / ANDROID",
    title: "Pomodoro Study Planner",
    org: "Personal project",
    when: "12K+ INSTALLS",
    summary:
      "Designed, built and published a Pomodoro study app with a focus timer, study statistics, per-subject progress tracking and light/dark themes.",
    links: [
      {
        label: "Cafe Bazaar",
        url: "https://cafebazaar.ir/app/com.rntest",
        logo: { src: asset("logos/bazaar.png"), alt: "Cafe Bazaar" },
      },
      {
        label: "Myket",
        url: "https://myket.ir/app/com.rntest",
        logo: { src: asset("logos/myket.png"), alt: "Myket" },
      },
    ],
    points: [],
    stack: ["React Native", "Android"],
  },
];
---

<Layout
  title="Amir Mohammad Kahfi — Software Engineer"
  description="Back-end-focused software engineer building Node.js systems and the retrieval layers that make LLMs useful. Nest.js, PostgreSQL, Redis, Docker, RAG and vector search."
>
  <div class="progress" id="progress"></div>

  <div class="cursor-hud" aria-hidden="true">
    <div class="cursor-hud__ring"></div>
    <div class="cursor-hud__dot"></div>
    <div class="cursor-hud__coords">0000 · 0000</div>
  </div>

  <header class="nav">
    <div class="wrap nav__inner">
      <div class="brand">
        <button
          type="button"
          class="brand__avatar-btn"
          id="portraitOpen"
          aria-haspopup="dialog"
          aria-controls="portraitLightbox"
          aria-label="View photo"
        >
          <img
            class="brand__avatar"
            id="portraitThumb"
            src={asset("images/portrait.jpg")}
            alt=""
            width="36"
            height="36"
            loading="eager"
            decoding="async"
          />
        </button>
        <a class="brand__name" href="#top" data-nav="0">AMK</a>
      </div>
      <div class="nav__end">
        <nav class="nav__links" aria-label="Sections">
          <a href="#about">About</a>
          <a href="#stack">Stack</a>
          <a href="#experience">Experience</a>
          <a href="#work">Work</a>
          <a href="#education">Education</a>
          <button type="button" class="nav__resume" id="resumeOpen" aria-haspopup="dialog" aria-controls="resumeLightbox">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 4v10m0 0 3.5-3.5M12 14l-3.5-3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
              <path d="M5 18h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
            </svg>
            Resume
          </button>
          <a class="nav__cta" href="#contact">Contact</a>
        </nav>
        <button class="theme-toggle" id="themeToggle" type="button" aria-label="Switch to light theme" aria-pressed="false">
          <svg class="moon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
          </svg>
          <svg class="sun" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6"></circle>
            <path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M19.1 4.9l-1.8 1.8M6.7 17.3l-1.8 1.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
          </svg>
        </button>
      </div>
    </div>
  </header>

  <div
    class="portrait-lightbox"
    id="portraitLightbox"
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
    aria-label="Amir Mohammad Kahfi"
    hidden
  >
    <button type="button" class="portrait-lightbox__backdrop" id="portraitCloseBg" tabindex="-1" aria-label="Close photo"></button>
    <div class="portrait-lightbox__stage">
      <img
        class="portrait-lightbox__img"
        id="portraitFull"
        src={asset("images/portrait.jpg")}
        alt="Amir Mohammad Kahfi"
        width="800"
        height="1000"
      />
      <p class="portrait-lightbox__caption">Amir Mohammad Kahfi</p>
      <button type="button" class="portrait-lightbox__close" id="portraitClose" aria-label="Close photo">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <div
    class="resume-lightbox"
    id="resumeLightbox"
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
    aria-label="Resume"
    hidden
  >
    <button type="button" class="resume-lightbox__backdrop" id="resumeCloseBg" tabindex="-1" aria-label="Close resume"></button>
    <div class="resume-lightbox__panel">
      <div class="resume-lightbox__bar">
        <span class="resume-lightbox__title">Resume</span>
        <div class="resume-lightbox__actions">
          <button type="button" class="resume-lightbox__download" id="resumeDownload">Download PDF</button>
          <button type="button" class="resume-lightbox__close" id="resumeClose" aria-label="Close resume">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
            </svg>
          </button>
        </div>
      </div>
      <div class="resume-lightbox__frame-wrap">
        <p class="resume-lightbox__status" id="resumeStatus">Loading resume…</p>
        <iframe class="resume-lightbox__frame" id="resumeFrame" title="Amir Mohammad Kahfi resume"></iframe>
      </div>
    </div>
  </div>

  <main id="top">
    <div class="journey-track" id="journeyTrack">
      <div class="journey-viewport" id="journeyViewport">
        <!-- Full-screen WebGL 3D Canvas -->
        <canvas id="threeCanvas" class="journey__canvas" aria-hidden="true"></canvas>

        <!-- Side Scroller HUD & Timeline Navigator -->
        <aside class="journey__hud" aria-label="Portfolio chapters">
          <div class="hud__track">
            <div class="hud__fill" id="hudProgressFill"></div>
          </div>
          <div class="hud__list">
            <button type="button" class="hud__item is-active" data-chapter="0">
              <span class="hud__idx">00</span>
              <span class="hud__label">ORIGIN</span>
            </button>
            <button type="button" class="hud__item" data-chapter="1">
              <span class="hud__idx">01</span>
              <span class="hud__label">ABOUT</span>
            </button>
            <button type="button" class="hud__item" data-chapter="2">
              <span class="hud__idx">02</span>
              <span class="hud__label">STACK</span>
            </button>
            <button type="button" class="hud__item" data-chapter="3">
              <span class="hud__idx">03</span>
              <span class="hud__label">EXPERIENCE</span>
            </button>
            <button type="button" class="hud__item" data-chapter="4">
              <span class="hud__idx">04</span>
              <span class="hud__label">WORK</span>
            </button>
            <button type="button" class="hud__item" data-chapter="5">
              <span class="hud__idx">05</span>
              <span class="hud__label">EDUCATION</span>
            </button>
            <button type="button" class="hud__item" data-chapter="6">
              <span class="hud__idx">06</span>
              <span class="hud__label">CONTACT</span>
            </button>
          </div>
          <div class="hud__scroll-cue">
            <span>SCROLL</span>
            <span class="cue-arrow">↓</span>
          </div>
        </aside>

        <!-- CHAPTER 00: IDENTITY & WHOAMI -->
        <section class="chapter chapter--0 is-active" id="ch-0">
          <div class="chapter__wrap hero__inner">
            <div>
              <span class="eyebrow"
                ><i></i> Available for hard problems · Tehran, Iran</span
              >
              <h1 class="hero__title">
                <span>Amir Mohammad</span>
                <span class="outline"><b data-glitch="Kahfi">Kahfi</b><b class="star">✳</b></span>
              </h1>
              <p class="hero__lead">
                Back-end-focused software engineer building server-side systems in{" "}
                <strong>Node.js</strong> — and the retrieval layers that make LLMs
                actually useful. Clean design, maintainable code, production
                behaviour.
              </p>
              <div class="hero__actions">
                <a class="btn btn--solid" href="#work" data-nav="4"
                  >Selected work <span class="btn__arrow">↗</span></a
                >
                <a class="btn" href="#contact" data-nav="6">Get in touch</a>
                <a
                  class="btn"
                  href="https://github.com/SArshiaK"
                  target="_blank"
                  rel="noreferrer">GitHub <span class="btn__arrow">↗</span></a
                >
              </div>
            </div>

            <div class="term" aria-hidden="true">
              <div class="term__bar">
                <i></i><i></i><i></i>
                <span>~/amk — zsh</span>
              </div>
              <div class="term__body">
                <p><span class="c">$</span> <span class="p">whoami</span></p>
                <p>
                  <span class="v">amir_mohammad_kahfi</span>{" "}
                  <span class="c">// software engineer</span>
                </p>
                <p><span class="c">$</span> <span class="p">cat</span> focus.txt</p>
                <p>
                  <span class="s">"back-end systems · retrieval-augmented LLMs"</span>
                </p>
                <p><span class="c">$</span> <span class="p">ls</span> ~/stack</p>
                <p>
                  <span class="k">nest</span> <span class="k">next</span>
                  <span class="k">postgres</span> <span class="k">redis</span>
                  <span class="k">docker</span> <span class="k">qdrant</span>
                  <span class="k">ollama</span>
                </p>
                <p>
                  <span class="c">$</span> <span class="p">status</span>{" "}--available<span class="cursor"></span>
                </p>
              </div>
            </div>
          </div>
        </section>

        <!-- CHAPTER 01: ABOUT & PHILOSOPHY -->
        <section class="chapter chapter--1" id="ch-1">
          <div class="chapter__wrap">
            <div class="sec__head">
              <div>
                <span class="sec__idx">01 — About</span>
                <h2 class="sec__title">
                  Back-end first,<br /><em>retrieval obsessed.</em>
                </h2>
              </div>
              <p class="sec__note">Design · build · ship · keep it readable</p>
            </div>

            <div class="about__grid">
              <div class="about__copy">
                <p>
                  I'm a software engineer who lives on the server side. Most of my
                  work is Node.js: APIs, databases, background queues and
                  integrations — software designed to be understood six months
                  later, by someone who isn't me.
                </p>
                <p>
                  Lately I've been building the layer between LLMs and reality:
                  embedding pipelines, vector search, hybrid BM25 ranking, and
                  prompts constrained enough that answers stay grounded. I work
                  closely with front-end and cross-functional teams, and I like
                  owning a feature from schema to shipped behaviour.
                </p>
              </div>

              <div class="jsoncard">
                <div class="jsoncard__head">
                  <span>engineer.json</span><span>UTF-8</span>
                </div>
                <pre><span class="punc">&#123;</span>
  <span class="key">"name"</span><span class="punc">:</span> <span class="str">"Amir Mohammad Kahfi"</span><span class="punc">,</span>
  <span class="key">"role"</span><span class="punc">:</span> <span class="str">"software_engineer"</span><span class="punc">,</span>
  <span class="key">"based_in"</span><span class="punc">:</span> <span class="str">"Tehran, IR"</span><span class="punc">,</span>
  <span class="key">"focus"</span><span class="punc">:</span> <span class="str">"back-end · retrieval · LLM"</span><span class="punc">,</span>
  <span class="key">"stack"</span><span class="punc">:</span> <span class="punc">[</span><span class="str">"node"</span><span class="punc">,</span> <span class="str">"nest"</span><span class="punc">,</span> <span class="str">"postgres"</span><span class="punc">]</span><span class="punc">,</span>
  <span class="key">"shipping_since"</span><span class="punc">:</span> <span class="num">2023</span><span class="punc">,</span>
  <span class="key">"currently"</span><span class="punc">:</span> <span class="str">"M.Sc. @ IUST"</span><span class="punc">,</span>
  <span class="key">"open_to"</span><span class="punc">:</span> <span class="str">"hard problems"</span><span class="punc">,</span>
  <span class="key">"available"</span><span class="punc">:</span> <span class="bool">true</span>
<span class="punc">&#125;</span></pre>
              </div>
            </div>
          </div>
        </section>

        <!-- CHAPTER 02: STACK & CAPABILITIES -->
        <section class="chapter chapter--2" id="ch-2">
          <div class="chapter__wrap">
            <div class="sec__head">
              <div>
                <span class="sec__idx">02 — Stack</span>
                <h2 class="sec__title">The tools I reach for.</h2>
              </div>
              <p class="sec__note">
                Chosen for boring reliability,<br />not for the README.
              </p>
            </div>

            <div class="chapter-stack__grid">
              <div class="chapter-stack__col">
                {stack.slice(0, 4).map((row) => (
                  <div class="stack-box">
                    <span class="stack-box__label">{row.k}</span>
                    <div class="stack-box__chips">
                      {row.v.map((item) => (
                        <span class="chip">{item}</span>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
              <div class="chapter-stack__col">
                {stack.slice(4).map((row) => (
                  <div class="stack-box">
                    <span class="stack-box__label">{row.k}</span>
                    <div class="stack-box__chips">
                      {row.v.map((item) => (
                        <span class="chip">{item}</span>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </section>

        <!-- CHAPTER 03: EXPERIENCE & RESEARCH -->
        <section class="chapter chapter--3" id="ch-3">
          <div class="chapter__wrap">
            <div class="sec__head">
              <div>
                <span class="sec__idx">03 — Experience</span>
                <h2 class="sec__title">Where I've been building.</h2>
              </div>
              <p class="sec__note">Three years · two banks · one obsession</p>
            </div>

            <div class="chapter-jobs">
              {jobs.map((job) => (
                <article class="chapter-job">
                  <div class="chapter-job__time">
                    {job.time}
                    <small>{job.type}</small>
                  </div>
                  <div>
                    <h3 class="chapter-job__role">{job.role}</h3>
                    <div class="chapter-job__org">
                      {job.logo && (
                        <img
                          class="brand-logo"
                          src={`${job.logo.src}?v=3`}
                          alt=""
                          width="44"
                          height="44"
                          loading="lazy"
                          decoding="async"
                        />
                      )}
                      <span>{job.org}</span>
                    </div>
                    <p class="chapter-job__desc">{job.desc}</p>
                  </div>
                </article>
              ))}

              <a
                class="chapter-job"
                href="https://webpages.iust.ac.ir/msharifi/dslab.html#members"
                target="_blank"
                rel="noreferrer"
                style="text-decoration:none;"
              >
                <div class="chapter-job__time">
                  2025 — Present
                  <small>Research</small>
                </div>
                <div>
                  <h3 class="chapter-job__role">
                    <img
                      class="brand-logo brand-logo--inline"
                      src={`${asset("logos/iust.png")}?v=3`}
                      alt=""
                      width="44"
                      height="44"
                      loading="lazy"
                      decoding="async"
                    />
                    Distributed Systems Lab · IUST
                  </h3>
                  <div class="chapter-job__org">Federated Learning &amp; Self-Healing</div>
                  <p class="chapter-job__desc">
                    Researching self-healing distributed algorithms and federated learning backplanes under the supervision of Prof. M. Sharifi.
                  </p>
                </div>
              </a>
            </div>
          </div>
        </section>

        <!-- CHAPTER 04: SELECTED WORK (PROJECT SHOWCASE) -->
        <section class="chapter chapter--4" id="ch-4">
          <div class="chapter__wrap chapter-work">
            <div class="chapter-work__grid">
              <!-- Left: Section Head & Interactive Project Buttons -->
              <div class="chapter-work__nav">
                <div class="sec__head sec__head--compact">
                  <div>
                    <span class="sec__idx">04 — Selected work</span>
                    <h2 class="sec__title">Things that<br /><em>do the work.</em></h2>
                  </div>
                </div>

                <div class="work-selector" id="workTabs">
                  {projects.map((p, idx) => (
                    <button
                      type="button"
                      class:list={["work-btn", { "is-active": idx === 0 }]}
                      data-pindex={idx}
                    >
                      <span class="work-btn__num">{p.n}</span>
                      <span class="work-btn__info">
                        <span class="work-btn__title">{p.title}</span>
                        <span class="work-btn__tag">{p.tag}</span>
                      </span>
                    </button>
                  ))}
                </div>
              </div>

              <!-- Right: Active Project Card Display -->
              <div class="work-display" id="workDisplay">
                {projects.map((p, idx) => (
                  <article
                    class:list={["project", "work-card", { "is-active": idx === 0, "project--featured": p.featured }]}
                    id={`pcard-${idx}`}
                  >
                    <div class="project__top">
                      <span class="project__num">{p.n}</span>
                      <span class:list={["project__tag", { "project__tag--alt": p.featured }]}>{p.tag}</span>
                      <span class="project__when">{p.when}</span>
                    </div>
                    <h3 class="project__title">{p.title}</h3>
                    <div class="project__org">
                      {p.logo && (
                        <img
                          class="brand-logo"
                          src={`${p.logo.src}?v=3`}
                          alt=""
                          width="40"
                          height="40"
                          loading="lazy"
                          decoding="async"
                        />
                      )}
                      <span>{p.org}</span>
                    </div>
                    <div class:list={["project__body", { "project__body--single": p.points.length === 0 }]}>
                      <div>
                        <p class="project__summary">{p.summary}</p>
                        {p.links && p.links.length > 0 && (
                          <div class="project__published">
                            <span class="project__published-label">Published:</span>
                            <div class="project__published-links">
                              {p.links.map((link) => (
                                <a
                                  href={link.url}
                                  target="_blank"
                                  rel="noreferrer"
                                  class="project__link"
                                >
                                  {link.logo && (
                                    <img
                                      class="brand-logo brand-logo--store"
                                      src={`${link.logo.src}?v=3`}
                                      alt=""
                                      width="24"
                                      height="24"
                                      loading="lazy"
                                      decoding="async"
                                    />
                                  )}
                                  {link.label}
